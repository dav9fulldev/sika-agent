# ==============================================================================
# SIKA BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Application Environment (development / production)
ENV=development
PORT=8080

# Security & OAuth2 Bearer Tokens (PyJWT HS256)
# IMPORTANT: In production, supply a strong cryptographically random 32+ char secret.
JWT_SECRET_KEY=sika_default_jwt_secret_dev_key_only_change_in_prod_32_chars

# Database Configuration (PostgreSQL / Google Cloud SQL)
# In local development without PostgreSQL, the backend falls back to local SQLite.
# Leave as-is for a quick local run: when PostgreSQL is unreachable in development, SQLite (sika_local.db) is used.
DATABASE_URL=sqlite:///./sika_local.db

# Distributed Cache & Rate Limiting (Redis / Google Cloud Memorystore)
# In local development without Redis, the backend falls back to safe in-memory stores.
REDIS_URL=redis://localhost:6379/0

# Google Cloud & Vertex AI Configuration (google-genai SDK)
# Used for natural language reasoning, intent extraction, and response synthesis.
GOOGLE_CLOUD_PROJECT=sika-all-things-agentic
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
AI_PROVIDER=gemini

# Optional: Gemini Developer API key (Google AI Studio). If set, it is used instead of Vertex AI/ADC.
# Leave empty to use Vertex AI with Application Default Credentials (gcloud auth application-default login).
GEMINI_API_KEY=

# ==============================================================================
# PAYMENT PROVIDER — PayPal REST API (SANDBOX ONLY)
# Create a sandbox REST app at https://developer.paypal.com/dashboard/applications/sandbox
# These secrets stay on the backend. Never put them in the Flutter app.
# ==============================================================================
PAYPAL_ENV=sandbox
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Public URL of this backend as reachable from the phone (used for PayPal return/cancel redirects)
PUBLIC_BASE_URL=http://192.168.1.10:8001
PAYPAL_BRAND_NAME=SIKA Demo Store
PAYPAL_ALLOWED_CURRENCIES=USD
PAYPAL_MAX_ORDER_AMOUNT=500
PAYPAL_CONFIRMATION_TTL_SECONDS=900
# Optional: webhook ID (otherwise found by its URL, see scripts/paypal_register_webhook.py)
PAYPAL_WEBHOOK_ID=
# Optional: Log in with PayPal return page (defaults to ${PUBLIC_BASE_URL}/api/v1/sika/auth/paypal/return,
# must match the Return URL set in the PayPal app)
PAYPAL_LOGIN_REDIRECT_URI=


# Optional Fallbacks
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
